# Repository-owned implementation of the make-v1 facade phases (root Makefile is
# generated by the central repository-execution tooling and must not be edited).

.PHONY: repo-setup repo-validate repo-check repo-test \
	sync lock-check fmt lint typecheck pytest catalog-check check-law ci

# uv is the locked-toolchain installer; CI runners may not have it (pin as in Cursor-Governance Repo.mk).
repo-setup: ## Install uv if absent, then the locked environment (uv.lock)
	@command -v uv >/dev/null 2>&1 || python3 -m pip install --only-binary=:all: uv==0.12.1
	$(MAKE) --no-print-directory sync
repo-validate: lock-check catalog-check ## Validate uv.lock and catalog/profile integrity
repo-check: lint typecheck ## Ruff format/lint and pyright strict
repo-test: pytest ## Run the pytest suite

sync: ## uv sync --frozen
	uv sync --frozen

lock-check: ## Fail if uv.lock is out of date with pyproject.toml
	uv lock --check

fmt: ## Apply ruff formatting
	uv run ruff format l9_conformance scripts tests

lint: ## ruff format --check and ruff check
	uv run ruff format --check l9_conformance scripts tests
	uv run ruff check l9_conformance scripts tests

typecheck: ## pyright strict
	uv run pyright

pytest: ## pytest
	uv run python -m pytest tests

catalog-check: ## Core profile witness and catalog integrity
	uv run python scripts/check_core_profile.py
	uv run python scripts/check_catalog.py

# LAW_ROOT=<Quantum-L9/.github checkout at the pinned revision>
check-law: ## Catalog integrity plus trace of fixtures to pinned law
	uv run python scripts/check_catalog.py --law-root $(LAW_ROOT)

ci: setup validate check test ## All four facade phases
