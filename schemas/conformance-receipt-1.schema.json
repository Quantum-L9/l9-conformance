{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9-conformance/conformance-receipt@1",
  "title": "l9-conformance conformance receipt v1",
  "description": "Immutable evidence binding an exact node artifact and implementation to the exact conformance closure executed and the observed per-obligation outcomes. Specializes receipt family l9.receipt/conformance@1 (Quantum-L9/.github semantics/receipt_catalog.yaml). Evidence only: it is not admission, not authorization, and carries no mutable currentness status; currentness is derived by evaluating governing_coordinates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_type",
    "receipt_identity",
    "receipt_digest",
    "exact_subject_ref",
    "claim",
    "governing_coordinates",
    "observation_or_outcome",
    "verification_basis",
    "producer_identity",
    "evidence_grade",
    "authority",
    "emitted_at"
  ],
  "properties": {
    "schema": {
      "const": "l9-conformance/conformance-receipt@1"
    },
    "receipt_type": {
      "const": "l9.receipt/conformance@1"
    },
    "receipt_identity": {
      "type": "string",
      "pattern": "^l9-conformance/receipt:sha256:[0-9a-f]{64}$"
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "exact_subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "node_artifact",
        "implementation"
      ],
      "properties": {
        "product_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "node_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_schema",
            "manifest_digest",
            "files"
          ],
          "properties": {
            "manifest_schema": {
              "enum": [
                "l9.semantic-compiler.node-artifact-manifest/v1",
                "l9-conformance/source-subject-manifest@0",
                "l9-conformance/synthetic-node-manifest@0"
              ]
            },
            "manifest_digest": {
              "$ref": "#/$defs/digest"
            },
            "files": {
              "$ref": "#/$defs/fileDigests"
            },
            "compilation_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "receipt_identity",
                "receipt_digest"
              ],
              "properties": {
                "receipt_identity": {
                  "type": "string",
                  "pattern": "^l9\\.receipt-instance/[0-9a-f]{64}$"
                },
                "receipt_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_revision",
            "source_revision_basis",
            "bound_source_digest"
          ],
          "properties": {
            "source_revision": {
              "$ref": "#/$defs/nonEmpty"
            },
            "bound_source_digest": {
              "$ref": "#/$defs/digest"
            },
            "source_revision_basis": {
              "const": "caller_supplied",
              "description": "No compiler or conformance input attests the product source revision; it is recorded as supplied by the caller. Bound source identity is bound_source_digest."
            }
          }
        }
      }
    },
    "claim": {
      "const": "The exact subject was executed against the exact bound conformance closure and produced the recorded per-obligation outcomes. This receipt does not admit, authorize, or publish the subject."
    },
    "governing_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_authority",
        "semantic_source_digests",
        "conformance_ir",
        "fixture_ir",
        "rendered_suite",
        "profiles"
      ],
      "properties": {
        "canonical_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "admitted"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/nonEmpty"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "admitted": {
              "type": "boolean"
            }
          }
        },
        "semantic_source_digests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/nonEmpty"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "conformance_ir": {
          "$ref": "#/$defs/irRef"
        },
        "fixture_ir": {
          "$ref": "#/$defs/irRef"
        },
        "rendered_suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "files"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "files": {
              "$ref": "#/$defs/fileDigests"
            }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/refDigest"
          }
        },
        "harness": {
          "description": "Conformance-harness code executed by the run (coordinator ruling D5). Every file under the declared harness root is bound by raw sha256; the harness never ships in the node artifact.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_revision",
            "source_revision_basis",
            "root",
            "driver_ref",
            "digest",
            "files"
          ],
          "properties": {
            "source_revision": {
              "$ref": "#/$defs/nonEmpty"
            },
            "source_revision_basis": {
              "const": "caller_supplied"
            },
            "root": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
            },
            "driver_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "files": {
              "$ref": "#/$defs/fileDigests"
            }
          }
        }
      }
    },
    "observation_or_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligations",
        "overall_verdict"
      ],
      "properties": {
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligation_id",
              "verification_class",
              "required",
              "verdict",
              "cases"
            ],
            "properties": {
              "obligation_id": {
                "$ref": "#/$defs/nonEmpty"
              },
              "verification_class": {
                "enum": [
                  "fixture_replay",
                  "static_inspection",
                  "external_runtime_evidence"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "verdict": {
                "$ref": "#/$defs/verdict"
              },
              "reason": {
                "type": "string"
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "case_id",
                    "verdict",
                    "detail"
                  ],
                  "properties": {
                    "case_id": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "verdict": {
                      "$ref": "#/$defs/verdict"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "record_digest": {
                      "$ref": "#/$defs/digest"
                    }
                  }
                }
              }
            }
          }
        },
        "overall_verdict": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "verification_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation",
        "case_records",
        "reproduction"
      ],
      "properties": {
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "achieved",
            "level",
            "network",
            "limitations"
          ],
          "properties": {
            "requested": {
              "$ref": "#/$defs/nonEmpty"
            },
            "achieved": {
              "$ref": "#/$defs/nonEmpty"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "level": {
              "enum": [
                "process",
                "container"
              ]
            },
            "network": {
              "enum": [
                "best_effort_unrestricted",
                "blocked"
              ]
            }
          }
        },
        "case_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "exit_code",
              "junit_digest"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/nonEmpty"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "junit_digest": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "reproduction": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "version",
        "code_digest"
      ],
      "properties": {
        "runner": {
          "const": "l9-conformance/runner"
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        },
        "code_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence_grade": {
      "enum": [
        "canonical",
        "candidate_authority_rehearsal",
        "synthetic_test"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_semantic_authority",
        "grants_execution_authority",
        "is_admission"
      ],
      "properties": {
        "grants_semantic_authority": {
          "const": false
        },
        "grants_execution_authority": {
          "const": false
        },
        "is_admission": {
          "const": false
        }
      }
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error",
        "unresolved"
      ]
    },
    "refDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "fileDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/nonEmpty"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "irRef": {
      "description": "An IR bound by raw file-byte digest and, when its format defines one, by its semantic digest (canonical JSON of the parsed document; ruling D8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
